{
	"compilerOptions": {
		"baseUrl": ".",
		"inlineSourceMap": true,
		"inlineSources": true,
		"module": "ESNext",
		"target": "ES6",
		"allowJs": true,
		"noImplicitAny": true,
		"moduleResolution": "node",
		"importHelpers": true,
		"isolatedModules": true,
		"strictNullChecks": true,
		"strict": true,
		"lib": ["DOM", "ES6", "ES2021"],
		"paths": {
			"*": ["./node_modules/*"]
		}
	},
	"include": ["src/**/*.ts", "src/**/*.tsx"]
}
